# ---------------------------------------------------------------------------
# Ollama — modelo local (substitui Gemini/Google, sem API key necessária)
# Ollama deve estar rodando antes de iniciar o servidor.
# Para instalar: https://ollama.com
# Para baixar o modelo: ollama pull llama3.1
# Para rodar: ollama run llama3.1
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Servidor A2A local
# ---------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Cloudflare Quick Tunnel — URL gerada automaticamente a cada execução
# Não requer conta nem configuração prévia. Basta ter cloudflared instalado.
#   macOS:  brew install cloudflared
#
# ⚠️  A URL muda a cada restart de start-local.sh.
#     Após reiniciar, registre novamente no wxO com a nova URL.
# ---------------------------------------------------------------------------
# (nenhuma variável necessária — a URL é impressa no terminal pelo script)

# ---------------------------------------------------------------------------
# wxO telemetry — read by wxo_otel.py (WxoA2ATraceMiddleware)
# ---------------------------------------------------------------------------
# Identificador do provedor LLM nos spans OTel (gen_ai.system).
# Valores comuns: ollama | openai | anthropic | google_gemini
LLM_PROVIDER=ollama

WXO_API_KEY=<wxo-api-key-authorized-for-target-tenant>

WXO_AGENT_ID=<registered-external-agent-id>
WXO_AGENT_NAME=annualized_return_agent
WXO_AGENT_DISPLAY_NAME=Annualized Return Agent
WXO_TENANT_ID=<account-id>_<instance-id>

# live | draft
ENVIRONMENT_NAME=draft

TOKEN_URL=https://iam.cloud.ibm.com/identity/token
OTEL_EXPORT_URL=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>/v1/orchestrate/inject/traces

OTEL_SERVICE_NAME=annualized-return-agent
OTEL_SERVICE_VERSION=2.0.0

# Set to false to stop request/response content from being stored in traces
WXO_CAPTURE_CONTENT=true

# ---------------------------------------------------------------------------
# Segredo do endpoint A2A (protege o POST /)
# Gere com: openssl rand -hex 32
# ---------------------------------------------------------------------------
AGENT_API_KEY=<token-secreto-gerado-com-openssl>
